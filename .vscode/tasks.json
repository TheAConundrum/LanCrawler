{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Import VBA code to Excel",
            "dependsOn": [
                "1. Run Python Inject"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [],
            "detail": "Import VBA into Lan_Search_Tool.xlsm."
        },
        {
            "label": "Export from Excel to Disk",
            "dependsOn": [
                "2. Run xlwings Export"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [],
            "detail": "Export VBA from Lan_Search_Tool.xlsm into src/vba."
        },
        {
            "label": "Crawl LAN folder (picker)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}\\src\\crawler\\run_crawl.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "Crawl GUI → folder + Lan_Search_Tool.xlsm → AccDB merge or fresh snapshot."
        },
        {
            "label": "SummitLANScan (all network drives)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}\\src\\crawler\\summit_lan_scan.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "No picker: crawl every mapped network drive into AccDB (ReplaceRoot per drive)."
        },
        {
            "label": "Unlock workbook for layout edit",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}\\src\\unlock_workbook.py",
                "${workspaceFolder}\\Lan_Search_Tool.xlsm"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "detail": "Unprotect sheets, unlock cells, unhide Database; leave Excel open for Dashboard edits."
        },
        {
            "label": "1. Run Python Inject",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}\\src\\inject_vba.py",
                "${workspaceFolder}\\Lan_Search_Tool.xlsm"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": [],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "2. Run xlwings Export",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "& { echo y | & '${command:python.interpreterPath}' -m xlwings vba export --file '${workspaceFolder}\\Lan_Search_Tool.xlsm' }"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/vba"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}
